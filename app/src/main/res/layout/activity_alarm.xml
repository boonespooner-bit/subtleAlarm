<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_deep">

    <com.subtlealarm.app.GlowView
        android:id="@+id/glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6:30"
            android:textSize="76sp"
            android:textColor="@color/text"
            android:fontFamily="sans-serif-thin"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/time_to_wake"
            android:textSize="13sp"
            android:textColor="@color/gold_dim"
            android:fontFamily="sans-serif-light" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="56dp">

        <Button
            android:id="@+id/dismissButton"
            android:layout_width="220dp"
            android:layout_height="72dp"
            android:background="@drawable/btn_dismiss"
            android:text="@string/dismiss"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:letterSpacing="0.25"
            android:textColor="@color/gold"
            android:fontFamily="sans-serif-light"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/dismiss_hint"
            android:textSize="11sp"
            android:textColor="@color/text_dim"
            android:fontFamily="sans-serif-light" />
    </LinearLayout>
</FrameLayout>
