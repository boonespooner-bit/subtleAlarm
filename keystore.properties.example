# Copy to keystore.properties and fill in with YOUR upload key.
# keystore.properties and *.jks are gitignored - never commit either one.
# Generate the key with (run from the repo root):
#
#   keytool -genkeypair -v -keystore upload-keystore.jks \
#       -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
